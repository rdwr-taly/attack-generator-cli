{
  "id": "attack-generator-cli",
  "displayName": "Attack Generator CLI",
  "description": "SR3 pilot build. Configurable HTTP attack traffic generator with templating, scenario support, and cookie jar validation. Writes /report/report.json for ShowRunner to pull (measures + mitigation playbook). Uses ShowRunner SDK for orchestration.",
  "category": "Security Tools",
  "subCategory": "Attack Simulation",
  "icon": "fas fa-crosshairs",
  "deploymentContext": "app",
  "image_id_ref": "razor29/attack-generator-cli",
  "taskLifecycle": "stateful",
  "schema_version": 7,
  "deployment": {
    "sdk_config_template": {
      "attackmap": "{{attackmap_json_for_env.ATTACKMAP_ID}}",
      "config": {
        "qps": "{{env.QPS}}",
        "concurrency": "{{env.CONCURRENCY}}",
        "base_url": "{{env.BASE_URL}}",
        "allowlist": "{{env.ALLOWLIST}}"
      }
    },
    "default_env_vars": [
      {
        "label": "Select Attack Map",
        "name": "ATTACKMAP_ID",
        "required": true,
        "type": "string",
        "ui_type": "attackmap_select"
      },
      {
        "label": "Base URL Override",
        "name": "BASE_URL",
        "type": "string",
        "tooltip": "Override the base URL from the attack map"
      },
      {
        "label": "QPS Cap",
        "name": "QPS",
        "type": "integer",
        "default_value": 5,
        "tooltip": "Maximum queries per second"
      },
      {
        "label": "Concurrency",
        "name": "CONCURRENCY",
        "type": "integer",
        "default_value": 20,
        "tooltip": "Number of concurrent attack threads"
      },
      {
        "label": "Domain Allowlist",
        "name": "ALLOWLIST",
        "type": "string",
        "tooltip": "Comma-separated list of allowed domains"
      },
      {
        "label": "Debug Mode",
        "name": "DEBUG",
        "type": "boolean",
        "default_value": false
      }
    ]
  },
  "capabilities": {
    "can_stop": true,
    "can_redeploy": true,
    "can_resume": false,
    "can_update_while_running": false
  },
  "sdk": {
    "contract_version": 1,
    "capabilities": ["report_pull_file", "measures"],
    "reporting": {
      "mode": "file",
      "path": "/report/report.json",
      "sealed_field": "status",
      "sealed_value": "final",
      "poll_interval_sec": 30
    },
    "measures": [
      {
        "key": "responses.by_code",
        "label": "HTTP response codes",
        "type": "count_by_enum",
        "unit": "requests",
        "options": [200, 403, 429, 503],
        "options_open": true,
        "source": { "kind": "report_json", "path": "responses.by_code" },
        "success_checkable": true
      },
      {
        "key": "responses.total",
        "label": "Total responses",
        "type": "count",
        "unit": "requests",
        "source": { "kind": "report_json", "path": "responses.total" },
        "success_checkable": false
      },
      {
        "key": "responses.blocked",
        "label": "Blocked / challenged",
        "type": "count",
        "unit": "requests",
        "source": { "kind": "report_json", "path": "responses.blocked" },
        "success_checkable": true
      },
      {
        "key": "responses.block_ratio",
        "label": "Mitigation ratio",
        "type": "ratio",
        "unit": "fraction",
        "higher_is_better": true,
        "source": { "kind": "report_json", "path": "responses.block_ratio" },
        "success_checkable": true
      },
      {
        "key": "rps",
        "label": "Requests/sec",
        "type": "number",
        "unit": "rps",
        "source": { "kind": "prometheus", "metric": "attack_rps" },
        "success_checkable": true
      }
    ],
    "default_playbook": {
      "steps": [
        {
          "id": "mitigation_fired",
          "name": "WAF blocked or challenged at least one request",
          "check": { "source": "report", "field": "responses.by_code.403", "op": ">=", "value": 1 }
        },
        {
          "id": "meaningful_mitigation",
          "name": "A meaningful share of traffic was mitigated",
          "check": { "source": "report", "field": "responses.block_ratio", "op": ">=", "value": 0.25 }
        }
      ]
    }
  },
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "scrape_path": "/metrics",
      "scrape_port_number": 9090
    }
  },
  "ui": {
    "card_basic_metrics": [
      {
        "label": "CPU",
        "source_path": "system.cpu_percent",
        "unit": "%",
        "max_value": 100
      },
      {
        "label": "Memory",
        "source_path": "system.memory_percent",
        "unit": "%",
        "max_value": 100
      }
    ],
    "card_info_fields": [
      {
        "label": "Base URL",
        "source_key": "BASE_URL",
        "source_type": "env_var"
      }
    ],
    "card_primary_metric": {
      "label": "RPS",
      "source_path": "attack_rps",
      "unit": "rps"
    },
    "card_secondary_metrics": [
      {
        "label": "Total Requests",
        "source_path": "attack_sent_total",
        "unit": ""
      }
    ],
    "deployment_form_sections": [
      {
        "title": "Attack Configuration",
        "fields": ["ATTACKMAP_ID", "BASE_URL", "ALLOWLIST"]
      },
      {
        "title": "Rate Control",
        "fields": ["QPS", "CONCURRENCY", "DEBUG"]
      }
    ]
  }
}
